OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# If using LiteLLM Proxy (recommended for unified OpenAI/Claude/local models), set:
# Example: http://localhost:4000
LITELLM_BASE_URL=
# Optional (if your proxy uses a key):
LITELLM_API_KEY=

# Default model name/alias used by the generators
# Example: gpt-5.2, claude-3-5-sonnet, or a LiteLLM model alias
DND_DEFAULT_MODEL=gpt-5.2
# Upper bound for structured campaign-pack responses.
DND_CAMPAIGN_MAX_TOKENS=2600

# Optional: ComfyUI (Stable Diffusion) sidecar integration
# If set, campaign pack generation can auto-generate a small number of images.
# Example: http://localhost:8188
COMFYUI_BASE_URL=

# Required for ComfyUI generation: checkpoint file name as ComfyUI sees it (in its models/checkpoints folder)
# Example: fantasyMix_v20.safetensors
COMFYUI_CHECKPOINT=

# Optional tuning (keep small for ~8GB GPUs)
COMFYUI_WIDTH=768
COMFYUI_HEIGHT=768
COMFYUI_STEPS=8
COMFYUI_CFG=4.0
CAMPAIGN_IMAGE_PROVIDERS=auto
CAMPAIGN_IMAGE_MAX_IMAGES=2
CAMPAIGN_IMAGE_MODE=location

# Optional: Nano Banana 2 Streamable HTTP MCP image provider.
# Run the service separately and configure GEMINI_API_KEY on that service, not here.
NANO_BANANA_MCP_URL=
NANO_BANANA_RESOLUTION=1K
NANO_BANANA_ASPECT_RATIO=1:1
NANO_BANANA_THINKING=minimal
NANO_BANANA_TIMEOUT_SECONDS=900
